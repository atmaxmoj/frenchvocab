[
  {
    "id": "853",
    "note": "monter 有两义：物理上升与安装组装，对应 descendre 和 assembler 分别辨析上下与组装拆卸。",
    "members": [
      { "fr": "descendre", "pos": "verb", "gloss": "下降；下楼" },
      { "fr": "assembler", "pos": "verb", "gloss": "组装；集合" }
    ]
  },
  {
    "id": "854",
    "note": "promettre 是做承诺，tenir（parole）是兑现承诺，accomplir 是完成诺言之事。强化承诺→履行的全流程。",
    "members": [
      { "fr": "tenir", "pos": "verb", "gloss": "守约；坚持" },
      { "fr": "accomplir", "pos": "verb", "gloss": "完成；实现" }
    ]
  },
  {
    "id": "856",
    "note": "concentrer 浓缩/聚焦，其反面是 diluer（稀释）；fusionner 则是将分散物合并成一体。",
    "members": [
      { "fr": "diluer", "pos": "verb", "gloss": "稀释；冲淡" },
      { "fr": "fusionner", "pos": "verb", "gloss": "合并；融合" }
    ]
  },
  {
    "id": "858",
    "note": "composer 既可是写乐曲/文章（对应 écrire），也可是创意创作（对应 créer），记住这两义才能用准。",
    "members": [
      { "fr": "écrire", "pos": "verb", "gloss": "写作；著文" },
      { "fr": "créer", "pos": "verb", "gloss": "创造；创作" }
    ]
  },
  {
    "id": "859",
    "note": "chemin de fer 是固定搭配，单独的 chemin（道路）不能直译为铁路，必须整体记忆。",
    "members": [
      { "fr": "chemin de fer", "pos": "expr", "gloss": "铁路；火车" }
    ]
  },
  {
    "id": "861",
    "note": "法国行政区划：commune（市镇，最小级）→ région（大区，最大级）；zone 泛指区域/地带，非行政单位。",
    "members": [
      { "fr": "commune", "pos": "noun", "gloss": "市镇" },
      { "fr": "zone", "pos": "noun", "gloss": "区域；地带" },
      { "fr": "région", "pos": "noun", "gloss": "地区；大区" }
    ]
  },
  {
    "id": "862",
    "note": "élection 选举，voter 投票，candidat 参选者，三个词构成选举生态链。",
    "members": [
      { "fr": "voter", "pos": "verb", "gloss": "投票；表决" },
      { "fr": "candidat", "pos": "noun", "gloss": "候选人" }
    ]
  },
  {
    "id": "863",
    "note": "usage 既指实际使用方式，也指习惯性约定；habitude 和 coutume 都强调重复形成的习性，相互补充。",
    "members": [
      { "fr": "habitude", "pos": "noun", "gloss": "习惯；习俗" },
      { "fr": "coutume", "pos": "noun", "gloss": "风俗；传统" }
    ]
  },
  {
    "id": "864",
    "note": "conflit 是严肃的对立，dispute 更口头化争吵，désaccord 强调立场不同。冲突强度依次递减。",
    "members": [
      { "fr": "dispute", "pos": "noun", "gloss": "争执；吵架" },
      { "fr": "désaccord", "pos": "noun", "gloss": "分歧；意见不和" }
    ]
  },
  {
    "id": "866",
    "note": "enquête 是泛调查，sondage 特指抽样问卷调查，investigation 强调深入侦查。用途不同。",
    "members": [
      { "fr": "sondage", "pos": "noun", "gloss": "民意调查；抽样调查" },
      { "fr": "investigation", "pos": "noun", "gloss": "调查；探查" }
    ]
  },
  {
    "id": "867",
    "note": "terrain 既指物理地面（与 sol 同），也指领域/专长（与 champ 的“范畴”义呼应），一词多义要分清。",
    "members": [
      { "fr": "sol", "pos": "noun", "gloss": "土地；地面；土壤" },
      { "fr": "champ", "pos": "noun", "gloss": "田地；领地；范畴" }
    ]
  },
  {
    "id": "869",
    "note": "si 和 tellement 都表程度，但 tellement 常用于叙述（tellement que...），si 更直接。",
    "members": [
      { "fr": "tellement", "pos": "adv", "gloss": "如此；那么" },
      { "fr": "si", "pos": "adv", "gloss": "如此；那样" }
    ]
  },
  {
    "id": "871",
    "note": "时间链：hier（昨天）→ aujourd'hui（今天）→ demain（明天）；avenir 指更远期的未来。",
    "members": [
      { "fr": "hier", "pos": "adv", "gloss": "昨天；昨日" },
      { "fr": "aujourd'hui", "pos": "adv", "gloss": "今天" },
      { "fr": "avenir", "pos": "noun", "gloss": "未来；将来" }
    ]
  },
  {
    "id": "873",
    "note": "confier 是信任地托付或倾诉秘密（有信任色彩），révéler 是说出秘密但通常无信任或义务色彩。",
    "members": [
      { "fr": "confier", "pos": "verb", "gloss": "托付；倾诉" },
      { "fr": "révéler", "pos": "verb", "gloss": "透露；揭露" }
    ]
  },
  {
    "id": "874",
    "note": "remarquer 是先观察后评论，noter 是记录观察结果，observer 是纯观察。用法递进。",
    "members": [
      { "fr": "noter", "pos": "verb", "gloss": "注意；记下；评价" },
      { "fr": "observer", "pos": "verb", "gloss": "观察；遵守" }
    ]
  },
  {
    "id": "875",
    "note": "égard 既是对他人的尊重（avoir des égards），也是对事物的关注（à l'égard de），比 respect/considération 范围更宽。",
    "members": [
      { "fr": "respect", "pos": "noun", "gloss": "尊重；恭敬" },
      { "fr": "considération", "pos": "noun", "gloss": "考虑；关注；尊敬" }
    ]
  },
  {
    "id": "876",
    "note": "supérieur 的对立是 inférieur（级别低），与表品质的 meilleur/pire 不同。级别 vs 品质要区分。",
    "members": [
      { "fr": "inférieur", "pos": "adj", "gloss": "低级的；下位的" },
      { "fr": "meilleur", "pos": "adj", "gloss": "更好的；最好的" }
    ]
  },
  {
    "id": "878",
    "note": "condamner 是强力谴责并含法律定罪，blâmer 较轻（批评），juger 更中立（评判）。强度和色彩有别。",
    "members": [
      { "fr": "blâmer", "pos": "verb", "gloss": "责备；批评" },
      { "fr": "juger", "pos": "verb", "gloss": "判决；评判；判断" }
    ]
  },
  {
    "id": "879",
    "note": "principal 和 capital 都强调重要性，但 capital 更强调根本性/不可缺少，principal 更强调中心地位。",
    "members": [
      { "fr": "principal", "pos": "adj", "gloss": "主要的；首要的" },
      { "fr": "capital", "pos": "adj", "gloss": "至关重要的；根本的" }
    ]
  },
  {
    "id": "880",
    "note": "lien 是物理或抽象的纽带，rapport 强调比例关系/部分间联系，relation 强调人事交往关系。细度不同。",
    "members": [
      { "fr": "rapport", "pos": "noun", "gloss": "关系；联系；比例" },
      { "fr": "relation", "pos": "noun", "gloss": "关系；联系" }
    ]
  },
  {
    "id": "882",
    "note": "discussion 是中性讨论，débat 有对立辩论的意味，conversation 更轻松日常。形式和气氛有差。",
    "members": [
      { "fr": "débat", "pos": "noun", "gloss": "辩论；讨论" },
      { "fr": "conversation", "pos": "noun", "gloss": "谈话；闲谈" }
    ]
  },
  {
    "id": "883",
    "note": "limiter 是设定范围上限，restreindre 更强调压缩变小，borner 强调画线设边界。侧重点各异。",
    "members": [
      { "fr": "restreindre", "pos": "verb", "gloss": "限制；限定" },
      { "fr": "borner", "pos": "verb", "gloss": "划定界限；限制" }
    ]
  },
  {
    "id": "884",
    "note": "justifier 是说明理由（更正式），expliquer 是阐明原因，défendre 是主动替人辩护。态度和深度不同。",
    "members": [
      { "fr": "expliquer", "pos": "verb", "gloss": "解释；说明" },
      { "fr": "défendre", "pos": "verb", "gloss": "为……辩护；保卫" }
    ]
  },
  {
    "id": "886",
    "note": "sentiment 强调深层持久的感情（爱恨），émotion 强调短期激烈的情绪反应。时间幅度和强度有别。",
    "members": [
      { "fr": "émotion", "pos": "noun", "gloss": "情绪；情感" },
      { "fr": "sentiment", "pos": "noun", "gloss": "感情；心情" }
    ]
  },
  {
    "id": "887",
    "note": "tâche 是具体单位任务（一件事），travail 是宽泛工作，devoir 强调必须做的本分。粒度递增。",
    "members": [
      { "fr": "travail", "pos": "noun", "gloss": "工作；劳动" },
      { "fr": "devoir", "pos": "noun", "gloss": "义务；功课" }
    ]
  },
  {
    "id": "888",
    "note": "directement 既可表方向直接（无迂回），也可表态度直白；immédiatement 专指时间立刻，franchement 专指坦率。",
    "members": [
      { "fr": "immédiatement", "pos": "adv", "gloss": "立即；马上" },
      { "fr": "franchement", "pos": "adv", "gloss": "坦诚地；坦白地" }
    ]
  },
  {
    "id": "890",
    "note": "raconter 是叙述完整故事/经历，conter 略古雅（讲故事），dire 是说话基础动词，parler 是说话交谈。正式度和对象有差异。",
    "members": [
      { "fr": "conter", "pos": "verb", "gloss": "叙述；讲述" },
      { "fr": "dire", "pos": "verb", "gloss": "说；讲" },
      { "fr": "parler", "pos": "verb", "gloss": "说话；讲述" }
    ]
  },
  {
    "id": "892",
    "note": "développer 既可是展开，也可是观念详述、能力培养；grandir 强调人的生长，évoluer 强调过程改变。层面不同。",
    "members": [
      { "fr": "grandir", "pos": "verb", "gloss": "长大；成长" },
      { "fr": "évoluer", "pos": "verb", "gloss": "发展；演化" }
    ]
  },
  {
    "id": "894",
    "note": "contact 是初始接触点，communication 是信息交换过程，relation 是长期关系建立。阶段递进。",
    "members": [
      { "fr": "communication", "pos": "noun", "gloss": "交流；沟通" },
      { "fr": "relation", "pos": "noun", "gloss": "关系；联系" }
    ]
  },
  {
    "id": "895",
    "note": "conclure 既可是下结论（总结推理），也可缔结协议或结束（完毕），比 terminer 更含义务/合意的色彩。",
    "members": [
      { "fr": "résumer", "pos": "verb", "gloss": "总结；概括" },
      { "fr": "terminer", "pos": "verb", "gloss": "结束；完成" }
    ]
  },
  {
    "id": "896",
    "note": "fruit 是（抽象）成果/果实（劳动的回报），résultat 是中性结果，succès 是正面成功。价值色彩有别。",
    "members": [
      { "fr": "résultat", "pos": "noun", "gloss": "结果；成果" },
      { "fr": "succès", "pos": "noun", "gloss": "成功；胜利" }
    ]
  },
  {
    "id": "897",
    "note": "ouvert 既可是物理开着（对 fermé），也可是思想开放、热情坦诚（与 accueillant 相近），要据对象理解。",
    "members": [
      { "fr": "fermé", "pos": "adj", "gloss": "关闭的；封闭的" },
      { "fr": "accueillant", "pos": "adj", "gloss": "热情的；好客的" }
    ]
  },
  {
    "id": "898",
    "note": "investissement 是长期投入（有回报预期），placement 强调把钱放入收益产品，dépense 是消费支出。意图不同。",
    "members": [
      { "fr": "placement", "pos": "noun", "gloss": "投资；理财产品" },
      { "fr": "dépense", "pos": "noun", "gloss": "支出；花费" }
    ]
  },
  {
    "id": "899",
    "note": "insister 既可是重复强调观点（近 souligner），也可是坚决要求（近 exiger），后者语气更强。力度分化。",
    "members": [
      { "fr": "souligner", "pos": "verb", "gloss": "强调；着重" },
      { "fr": "exiger", "pos": "verb", "gloss": "要求；坚持" }
    ]
  },
  {
    "id": "900",
    "note": "avantage 是优势/好处，bénéfice 强调经济利益，inconvénient 是其对立面。经济 vs 相对优势。",
    "members": [
      { "fr": "bénéfice", "pos": "noun", "gloss": "利益；利润" },
      { "fr": "inconvénient", "pos": "noun", "gloss": "缺点；不便" }
    ]
  }
]
