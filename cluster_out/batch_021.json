    "id": "1053",
    "note": "surprendre（惊讶）→ réagir（反应）→ provoquer（引发），三词链条式关联：事件、反应、原因。",
    "members": [
      { "fr": "réagir", "pos": "verb", "gloss": "反应，作出回应" },
      { "fr": "provoquer", "pos": "verb", "gloss": "激怒，引发" }
    ]
  },
  {
    "id": "1056",
    "note": "améliorer 正向改善，perte 负向结果。一正一反构成对比，便于记忆。",
    "members": [
      { "fr": "perte", "pos": "noun", "gloss": "损失，亏损" }
    ]
  },
  {
    "id": "1058",
    "note": "réfléchir 本义「反射」（réfléchir la lumière），引申为「思考」。字面义→抽象义的演变。",
    "members": [
      { "fr": "lumière", "pos": "noun", "gloss": "光，光线" }
    ]
  },
  {
    "id": "1061",
    "note": "apprécier 含「感激」义。与 merci 一起学习「感谢」这一语义场。",
    "members": [
      { "fr": "merci", "pos": "noun", "gloss": "谢谢，感谢" }
    ]
  },
  {
    "id": "1064",
    "note": "étudiant 强调进行中的求学身份，élève 是学生的通称。两词同表「学生」但侧重略异，需辨析。",
    "members": [
      { "fr": "élève", "pos": "noun", "gloss": "学生，学员" }
    ]
  },
  {
    "id": "1068",
    "note": "élève 与 maître 是师徒对应关系。学制中的基本角色对，配对记忆效果最佳。",
    "members": [
      { "fr": "maître", "pos": "noun", "gloss": "主人，师傅" }
    ]
  },
  {
    "id": "1078",
    "note": "contenter 使满足（正向），perte 损失（负向）。情感结果的对比记忆。",
    "members": [
      { "fr": "perte", "pos": "noun", "gloss": "损失，亏损" }
    ]
  },
  {
    "id": "1082",
    "note": "citer 引用他人言论（被动），interroger 主动提问。言语交互的两种模式。",
    "members": [
      { "fr": "interroger", "pos": "verb", "gloss": "询问，审讯" }
    ]
  },
  {
    "id": "1087",
    "note": "avance 指提前/预付（时间维度），destiner 指预定用途（目的维度）。都含「事先规划」但维度不同。",
    "members": [
      { "fr": "destiner", "pos": "verb", "gloss": "预定，打算用于" }
    ]
  },
  {
    "id": "1089",
    "note": "causer 中性「引起」，provoquer 带挑衅/故意意味。近义词需辨析其感情色彩。",
    "members": [
      { "fr": "provoquer", "pos": "verb", "gloss": "激怒，引发" }
    ]
  },
  {
    "id": "1092",
    "note": "maître 与 élève 是学制中的基本关系对。必须配对学习以理解师生角色。",
    "members": [
      { "fr": "élève", "pos": "noun", "gloss": "学生，学员" }
    ]
  },
  {
    "id": "1093",
    "note": "interroger 询问/提问，citer 引用/援引。都涉及言语和信息来源，但前者侧重提问，后者侧重引述。",
    "members": [
      { "fr": "citer", "pos": "verb", "gloss": "引用，援引" }
    ]
  },
  {
    "id": "1096",
    "note": "vente 销售（正向商业活动），perte 损失（负向商业结果）。商业语境中的对比记忆。",
    "members": [
      { "fr": "perte", "pos": "noun", "gloss": "损失，亏损" }
    ]
  },
  {
    "id": "1097",
    "note": "ramener 带回来（往返动作），arrivée 到达（目的地）。动作序列的因果关联。",
    "members": [
      { "fr": "arrivée", "pos": "noun", "gloss": "到达，抵达" }
    ]
  },
  {
    "id": "1099",
    "note": "collègue 同事（组织内的并列关系），partenaire 搭档（项目的合作关系）。工作关系的两种类型需辨析。",
    "members": [
      { "fr": "partenaire", "pos": "noun", "gloss": "伙伴，搭档" }
    ]
  }
