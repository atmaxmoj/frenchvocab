  {"id":"102","note":"année表一整年的过程/周期，an是年的基本单位；需区分瞬间性vs持续性","members":[{"fr":"an","pos":"noun","gloss":"年（基本单位，不强调持续）"},{"fr":"année","pos":"noun","gloss":"年（强调整个过程/周期）"}]},
  {"id":"103","note":"toujours既表习惯性「总是」，也表困境中「仍然」；continuer表动作/状态的延续；encore强调状态未变","members":[{"fr":"continuer","pos":"verb","gloss":"继续；持续"},{"fr":"encore","pos":"adv","gloss":"还；仍然；再（强调状态未变）"},{"fr":"toujours","pos":"adv","gloss":"总是；始终；仍然"}]},
  {"id":"104","note":"tenir「拿、握」是基本义；porter同样涉及「携带」但侧重支撑/穿戴；两词都有引申的「保持」义，需区分握持方式","members":[{"fr":"tenir","pos":"verb","gloss":"拿；握；保持；维持"},{"fr":"porter","pos":"verb","gloss":"穿戴；携带；支撑"}]},
  {"id":"105","note":"porter「穿戴、携带」为中性；apporter「带来」强调移动朝向说话者；emporter「带走」强调离开说话者——三词需区分方向性","members":[{"fr":"porter","pos":"verb","gloss":"穿戴；携带（中性）"},{"fr":"apporter","pos":"verb","gloss":"带来；运来（朝向说话者）"},{"fr":"emporter","pos":"verb","gloss":"带走；拿走（离开说话者）"}]},
  {"id":"106","note":"dire更宽泛「说、表达」；parler「说话、谈论」；raconter「叙述、讲故事」强调完整叙事——三词层级递进","members":[{"fr":"dire","pos":"verb","gloss":"说；表达；讲"},{"fr":"parler","pos":"verb","gloss":"说话；谈论；交谈"},{"fr":"raconter","pos":"verb","gloss":"叙述；讲故事；讲述"}]},
  {"id":"107","note":"fort「强壮的；强烈的」；faible「弱的；微弱的」为直接反义对","members":[{"fr":"fort","pos":"adj","gloss":"强壮的；强烈的；有力的"},{"fr":"faible","pos":"adj","gloss":"弱的；微弱的；不足的"}]},
  {"id":"110","note":"certain「确定的、某个」；sûr「肯定的、安全的」——certain更多修饰对象，sûr修饰人的判断/状态安全","members":[{"fr":"certain","pos":"adj","gloss":"确定的；某个；肯定的"},{"fr":"sûr","pos":"adj","gloss":"肯定的；确凿的；安全的"}]},
