[
  {
    "id": "1001",
    "note": "auparavant（以前、事先）与désormais（从今以后）是时间对照词，常在对比古今/变化时一起用。",
    "members": [
      { "fr": "auparavant", "pos": "adv", "gloss": "以前；事先" },
      { "fr": "désormais", "pos": "adv", "gloss": "从今以后；此后" }
    ]
  },
  {
    "id": "1004",
    "note": "inscrire（登记、写下）与déposer（放下、提交）常搭配：先inscrire（登记信息），再déposer（提交文件），流程概念。",
    "members": [
      { "fr": "inscrire", "pos": "verb", "gloss": "登记；写下" },
      { "fr": "déposer", "pos": "verb", "gloss": "放下；提交" }
    ]
  },
  {
    "id": "1006",
    "note": "déclaration（正式声明）与recommandation（建议推荐）都是正式表述文件，但déclaration更强调官方性和申报性，recommandation更强调建议性和背书性。",
    "members": [
      { "fr": "déclaration", "pos": "noun", "gloss": "声明；申报" },
      { "fr": "recommandation", "pos": "noun", "gloss": "建议；推荐" }
    ]
  },
  {
    "id": "1009",
    "note": "complètement、absolument和certes三个副词表达程度和态度，但absolument更强调客观确定性，complètement更强调彻底性，certes更强调承认/当然。",
    "members": [
      { "fr": "complètement", "pos": "adv", "gloss": "完全地；彻底地" },
      { "fr": "absolument", "pos": "adv", "gloss": "绝对地；完全地" },
      { "fr": "certes", "pos": "adv", "gloss": "诚然；当然" }
    ]
  },
  {
    "id": "1012",
    "note": "salaire（工作薪水）、revenu（收入总称）与profit（利润/好处）三者都涉及经济收益但具体所指不同：salaire专指工作报酬，revenu更宽泛包括多种收入来源，profit强调利益/好处。",
    "members": [
      { "fr": "salaire", "pos": "noun", "gloss": "薪水；工资" },
      { "fr": "revenu", "pos": "noun", "gloss": "收入；所得" },
      { "fr": "profit", "pos": "noun", "gloss": "利润；收益" }
    ]
  },
  {
    "id": "1014",
    "note": "confirmer与déclaration搭配：déclaration需被confirmer才能生效，强调验证确认的重要性。",
    "members": [
      { "fr": "confirmer", "pos": "verb", "gloss": "确认；证实" },
      { "fr": "déclaration", "pos": "noun", "gloss": "声明；申报" }
    ]
  },
  {
    "id": "1016",
    "note": "lecture（阅读、朗读）与communication（交流、通讯）都涉及信息传递，但lecture偏书面接收，communication偏双向互动或广泛的信息交流。",
    "members": [
      { "fr": "lecture", "pos": "noun", "gloss": "阅读；朗读" },
      { "fr": "communication", "pos": "noun", "gloss": "交流；通讯" }
    ]
  },
  {
    "id": "1020",
    "note": "traverser（穿越、横渡）、remonter（重新上升、追溯）与rejoindre（重新加入、追赶上）都是方向动词。Remonter特别要记住时间意义（remonter aux origines追溯源头），traverser强调经过，rejoindre强调追上。",
    "members": [
      { "fr": "traverser", "pos": "verb", "gloss": "穿越；横渡" },
      { "fr": "remonter", "pos": "verb", "gloss": "重新上升；追溯" },
      { "fr": "rejoindre", "pos": "verb", "gloss": "重新加入；追赶上" }
    ]
  },
  {
    "id": "1023",
    "note": "autrement（不然、以不同方式）与absolument（绝对地）都表方式或态度，但autrement侧重选择性（另一种方式），absolument侧重确定性和完全性。",
    "members": [
      { "fr": "autrement", "pos": "adv", "gloss": "不然；以另一种方式" },
      { "fr": "absolument", "pos": "adv", "gloss": "绝对地；完全地" }
    ]
  },
  {
    "id": "1026",
    "note": "dur（坚硬、严酷）与lourd（沉重、繁重）都表负面特征但侧重点不同：dur侧重硬度和严酷性，lourd侧重重量感和精神负担，需辨析。",
    "members": [
      { "fr": "dur", "pos": "adj", "gloss": "坚硬的；严酷的" },
      { "fr": "lourd", "pos": "adj", "gloss": "沉重的；繁重的" }
    ]
  },
  {
    "id": "1031",
    "note": "lutter（斗争、搏斗）与attaquer（攻击、抨击）常关联但方向不同：lutter是主动抗争/防守，attaquer是发起攻击，二者都带对抗性。",
    "members": [
      { "fr": "lutter", "pos": "verb", "gloss": "斗争；搏斗" },
      { "fr": "attaquer", "pos": "verb", "gloss": "攻击；抨击" }
    ]
  },
  {
    "id": "1033",
    "note": "contenir有两义：容纳物体 vs 抑制情感。与application搭配时体现容纳应用的范围。",
    "members": [
      { "fr": "contenir", "pos": "verb", "gloss": "容纳；抑制" },
      { "fr": "application", "pos": "noun", "gloss": "应用；申请" }
    ]
  },
  {
    "id": "1035",
    "note": "modifier（修改、调整）与transformer（改变、转化）的区别：modifier是小幅调整局部，transformer是根本性改变，程度和范围不同。",
    "members": [
      { "fr": "modifier", "pos": "verb", "gloss": "修改；调整" },
      { "fr": "transformer", "pos": "verb", "gloss": "改变；转化" }
    ]
  },
  {
    "id": "1037",
    "note": "jugement既表判断也表判决，与engagement（承诺）对应：jugement是决定前的评估，engagement是决定后的承诺。",
    "members": [
      { "fr": "jugement", "pos": "noun", "gloss": "判断；判决" },
      { "fr": "engagement", "pos": "noun", "gloss": "承诺；约定" }
    ]
  },
  {
    "id": "1038",
    "note": "manque（缺乏、不足）与échec（失败、挫折）常关联：缺乏导致失败，échec强调结果的负面性，manque强调原因的不足。",
    "members": [
      { "fr": "manque", "pos": "noun", "gloss": "缺乏；不足" },
      { "fr": "échec", "pos": "noun", "gloss": "失败；挫折" }
    ]
  },
  {
    "id": "1039",
    "note": "manque（缺乏）、lutter（斗争）与échec（失败）形成因果链：缺乏→斗争→失败或成功，体现克服困难的过程。",
    "members": [
      { "fr": "manque", "pos": "noun", "gloss": "缺乏；不足" },
      { "fr": "lutter", "pos": "verb", "gloss": "斗争；搏斗" },
      { "fr": "échec", "pos": "noun", "gloss": "失败；挫折" }
    ]
  },
  {
    "id": "1041",
    "note": "susciter（激起、引起）与transformer（改变）搭配常见（激起改变），与modifier（部分调整）相对，强调激发作用导致根本性转变。",
    "members": [
      { "fr": "susciter", "pos": "verb", "gloss": "引起；激起" },
      { "fr": "transformer", "pos": "verb", "gloss": "改变；转化" }
    ]
  },
  {
    "id": "1042",
    "note": "engagement（承诺、约定）与jugement（判断）常搭配：engagement是做出的承诺，jugement是做出承诺前的判断，体现决策流程。",
    "members": [
      { "fr": "engagement", "pos": "noun", "gloss": "承诺；约定" },
      { "fr": "jugement", "pos": "noun", "gloss": "判断；判决" }
    ]
  },
  {
    "id": "1046",
    "note": "vote（投票）、jugement（判断）与engagement（承诺）都涉及决定，但vote特别强调集体/民主决策，jugement强调个人评价，engagement强调个人承诺。",
    "members": [
      { "fr": "vote", "pos": "noun", "gloss": "投票；表决" },
      { "fr": "jugement", "pos": "noun", "gloss": "判断；判决" },
      { "fr": "engagement", "pos": "noun", "gloss": "承诺；约定" }
    ]
  },
  {
    "id": "1047",
    "note": "renvoyer有多义：退回物品 vs 遣返人员 vs 解雇雇员，与regretter（后悔）关联时多指被renvoyer后的悔意，体现因果关系。",
    "members": [
      { "fr": "renvoyer", "pos": "verb", "gloss": "退回；解雇" },
      { "fr": "regretter", "pos": "verb", "gloss": "遗憾；后悔" }
    ]
  }
]
